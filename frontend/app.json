{
  "expo": {
    "name": "SecondBite",
    "slug": "secondbite-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "primaryColor": "#F39C12",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F39C12"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.secondbite.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F39C12"
      },
      "package": "com.secondbite.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "lang": "es"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir que $(PRODUCT_NAME) acceda a tu ubicación para mostrar productos cercanos."
        }
      ]
    ]
  }
}
